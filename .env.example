# Server Configuration
PORT=4546
GIN_MODE=release                       # Use 'debug' for local dev only

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=CHANGE_ME                  # Use a strong password in production
DB_NAME=careerdb
DB_SSLMODE=disable                     # Use 'require' for production

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://your-frontend.com   # Set to your actual domain

# JWT Configuration — MUST be changed before deploy
JWT_SECRET=CHANGE_ME_TO_RANDOM_256BIT_SECRET     # Generate: openssl rand -hex 32
JWT_EXPIRATION=24h

# Gemini API Configuration
GEMINI_API_KEY=CHANGE_ME_TO_YOUR_KEY
